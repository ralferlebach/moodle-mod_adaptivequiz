{{!
    @template mod_adaptivequiz/item_administration_parameter

    Renders one parameter of the item administration together with its state.

    Context variables required for this template:
    * name - display name of the parameter
    * value - current value of the parameter
    * error - error message when the value is not usable, false otherwise

    Example context (json):
    {
        "name": "Starting level",
        "value": 5,
        "error": false
    }
}}
<div class="row">
    <div class="col-4 text-right font-weight-bold">{{name}}:</div>
    <div class="col-2">{{value}}</div>
    <div class="col-2">
        <span
            class="badge {{^error}}bg-success{{/error}}{{#error}}bg-danger{{/error}} text-white"
        >
            {{^error}}{{#str}} ok {{/str}}{{/error}}{{#error}}{{error}}{{/error}}
        </span>
    </div>
</div>
