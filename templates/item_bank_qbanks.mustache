{{!
    @template mod_adaptivequiz/item_bank_qbanks

    Renders the question banks linked to an activity as its item bank.

    Context variables required for this template:
    * id - id of the activity instance
    * courseid - id of the course the activity lives in
    * hasthiscourseqbanks - whether any linked bank belongs to this course
    * thiscourseqbanks - the linked banks of this course
    * hasothercoursesqbanks - whether any linked bank belongs to another course
    * othercoursesqbanks - the linked banks of other courses
    * hasanyqbanks - whether any bank is linked at all

    Example context (json):
    {
        "id": 3,
        "courseid": 2,
        "hasthiscourseqbanks": true,
        "thiscourseqbanks": [
            {
                "url": "http://example.org/mod/qbank/view.php?id=5",
                "name": "Shared question bank",
                "actions": []
            }
        ],
        "hasothercoursesqbanks": false,
        "othercoursesqbanks": [],
        "hasanyqbanks": true
    }
}}
{{< mod_adaptivequiz/item_bank_settings_block}}
    {{$title}}{{#str}} itembankassignedqbanks, adaptivequiz {{/str}}{{/title}}
    {{$body}}
        {{#hasthiscourseqbanks}}
            {{< mod_adaptivequiz/question_banks_block }}
                {{$qbankstitle}}
                    {{#str}} itembankthiscourseqbanks, adaptivequiz {{/str}}
                {{/qbankstitle}}
                {{$qbanks}}
                    {{#thiscourseqbanks}}
                        {{> mod_adaptivequiz/question_bank }}
                    {{/thiscourseqbanks}}
                {{/qbanks}}
            {{/ mod_adaptivequiz/question_banks_block }}
        {{/hasthiscourseqbanks}}
        {{#hasothercoursesqbanks}}
            {{< mod_adaptivequiz/question_banks_block }}
                {{$qbankstitle}}
                    {{#str}} itembankothercoursesqbanks, adaptivequiz {{/str}}
                {{/qbankstitle}}
                {{$qbanks}}
                    {{#othercoursesqbanks}}
                        {{> mod_adaptivequiz/question_bank }}
                    {{/othercoursesqbanks}}
                {{/qbanks}}
            {{/ mod_adaptivequiz/question_banks_block }}
        {{/hasothercoursesqbanks}}
        {{^hasanyqbanks}}
            <p>{{#str}} noquestionbanks, adaptivequiz {{/str}}</p>
        {{/hasanyqbanks}}
    {{/body}}
    {{$footer}}
        <button
                class="btn btn-secondary"
                data-action="show-question-banks-dialog"
                data-id="{{id}}"
                data-course-id="{{courseid}}"
        >
            {{#str}} itembankassignqbank, adaptivequiz {{/str}}
        </button>
    {{/footer}}
    {{$js}}
        require(['mod_adaptivequiz/item_bank'], function(ItemBank) {
        ItemBank.init();
        });
    {{/js}}
{{/mod_adaptivequiz/item_bank_settings_block}}
