{{!
    @template mod_adaptivequiz/item_bank_qcats

    Renders the question categories linked to an activity as its item bank.

    Context variables required for this template:
    * id - id of the activity instance
    * courseid - id of the course the activity lives in
    * hasqcats - whether any category is linked
    * qcats - the linked categories

    Example context (json):
    {
        "id": 3,
        "courseid": 2,
        "hasqcats": true,
        "qcats": [
            {
                "url": "http://example.org/question/edit.php?cmid=5",
                "name": "Default for Course 1",
                "actions": []
            }
        ]
    }
}}
{{< mod_adaptivequiz/item_bank_settings_block}}
    {{$title}}{{#str}} itembankassignedqcats, adaptivequiz {{/str}}{{/title}}
    {{$body}}
        {{#hasthiscourseqcats}}
            {{< mod_adaptivequiz/question_banks_block }}
                {{$qbankstitle}}
                    {{#str}} itembankthiscourseqcats, adaptivequiz {{/str}}
                {{/qbankstitle}}
                {{$qbanks}}
                    {{#thiscourseqcats}}
                        {{> mod_adaptivequiz/question_bank }}
                    {{/thiscourseqcats}}
                {{/qbanks}}
            {{/ mod_adaptivequiz/question_banks_block }}
        {{/hasthiscourseqcats}}
        {{#hasothercoursesqcats}}
            {{< mod_adaptivequiz/question_banks_block }}
                {{$qbankstitle}}
                    {{#str}} itembankothercoursesqcats, adaptivequiz {{/str}}
                {{/qbankstitle}}
                {{$qbanks}}
                    {{#othercoursesqcats}}
                        {{> mod_adaptivequiz/question_bank }}
                    {{/othercoursesqcats}}
                {{/qbanks}}
            {{/ mod_adaptivequiz/question_banks_block }}
        {{/hasothercoursesqcats}}
        {{^hasanyqcats}}
            <p>{{#str}} itembanknoqcats, adaptivequiz {{/str}}</p>
        {{/hasanyqcats}}
    {{/body}}
{{/mod_adaptivequiz/item_bank_settings_block}}
