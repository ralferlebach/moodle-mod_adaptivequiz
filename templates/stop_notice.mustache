{{!
    @template mod_adaptivequiz/stop_notice

    How the attempt ended, when the participant may not expect it (issue #20). On the page as text,
    so it is there without JavaScript; with JavaScript it opens as a dialog the feedback waits for.

    Example context (json):
    {
        "title": "Your test has ended",
        "text": "The time for this test is up.",
        "iserror": false,
        "attemptid": 3,
        "acknowledged": false
    }
}}
<div class="alert {{#iserror}}alert-warning{{/iserror}}{{^iserror}}alert-info{{/iserror}}"
        data-region="adaptivequiz-stopnotice" tabindex="-1" role="region"
        aria-labelledby="adaptivequiz-stopnotice-title">
    <h3 class="h5" id="adaptivequiz-stopnotice-title" data-region="title">{{title}}</h3>
    <p class="mb-0" data-region="text">{{text}}</p>
</div>
{{^acknowledged}}
    {{#js}}
        require(['mod_adaptivequiz/stop_notice'], function(notice) {
            notice.init({{attemptid}});
        });
    {{/js}}
{{/acknowledged}}
